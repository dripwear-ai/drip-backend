{
  "expo": {
    "name": "DRIP",
    "slug": "drip-2-0",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.drip.fashion"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#211E1B"
      },
      "package": "com.drip.fashion"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#211E1B",
          "resizeMode": "contain"
        }
      ]
    ],
    "scheme": "drip"
  }
}
