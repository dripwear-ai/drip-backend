# ==============================================================================
# DRIP 2.0 Environment Configuration Template
# Copy this file to .env for local development. Never commit real credentials!
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true
DEV_BIND_ADDRESS=127.0.0.1

# Authoritative PostgreSQL Database
POSTGRES_USER=drip_user
POSTGRES_PASSWORD=drip_password
POSTGRES_DB=drip_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5435
DATABASE_URL=postgresql+asyncpg://drip_user:drip_password@localhost:5435/drip_db

# Ephemeral Redis Cache & Coordination
REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6381/0

# Security & Tokens (Generate secure random 32+ char strings in production)
SECRET_KEY=dev_secret_key_change_me_in_production_minimum_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8081,http://localhost:8083,exp://localhost:8081

# Next.js Web Portal (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Mobile Application (apps/mobile)
EXPO_PUBLIC_API_URL=http://localhost:8000
